# The only required setting: your database address. On Neon, click "Connect" and copy the connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional. Signs login cookies. If left out, the app makes its own key and keeps it in the database.
# SESSION_SECRET="a-long-random-string-of-at-least-32-characters"

# Optional. The app's public address for invite and reminder links. On Vercel it's detected automatically.
# APP_URL="https://time.yourcompany.com"

# Optional. Turns on the daily reminder job (Vercel sends this secret when it runs the job).
# CRON_SECRET="another-long-random-string"

# Optional. Email through Resend (resend.com). Without it, invite links are shown on screen and reminders are only logged.
# RESEND_API_KEY=""
# EMAIL_FROM="Clock me <timesheets@yourcompany.com>"

# Only for "npm run db:seed" on your own computer (a live site uses the setup page instead).
# ADMIN_EMAIL="you@yourcompany.com"
# ADMIN_PASSWORD="choose-a-strong-password"
# ADMIN_NAME="Your Name"
# ADMIN_OFFICE="New York"
