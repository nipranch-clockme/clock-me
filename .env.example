# Database: the Neon connection string (Neon dashboard > Connection details). Use the "pooled" one.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# A long random string that signs login cookies. Generate one with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-string"

# The app's public address, used in invite and reminder links (e.g. https://clockme.yourcompany.com)
APP_URL="http://localhost:3000"

# Protects the daily reminder job. Any long random string; Vercel sends it automatically.
CRON_SECRET="replace-with-another-random-string"

# Optional: email through Resend (resend.com). Without it, invites and reminders are only logged.
RESEND_API_KEY=""
EMAIL_FROM="Clock me <timesheets@yourcompany.com>"

# Used once by "npm run db:seed" to create the first admin.
ADMIN_EMAIL="you@yourcompany.com"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_NAME="Your Name"
ADMIN_OFFICE="New York"
