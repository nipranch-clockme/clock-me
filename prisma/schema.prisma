generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  LEADER
  LOCATION
  ADMIN
}

enum Access {
  PUBLIC
  RESTRICTED
}

/// FIXED: the client agreed to a set number of hours each month. FLOATING: no commitment, work as it comes.
enum ClientType {
  FIXED
  FLOATING
}

enum SheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model Location {
  id        String                  @id @default(cuid())
  name      String                  @unique
  managerId String?
  teams     Team[]
  users     User[]
  access    ProjectLocationAccess[]
  holidays  Holiday[]
}

model Team {
  id         String              @id @default(cuid())
  name       String
  locationId String
  location   Location            @relation(fields: [locationId], references: [id])
  users      User[]
  access     ProjectTeamAccess[]
  clients    Client[]

  @@unique([name, locationId])
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String
  title          String              @default("")
  passwordHash   String?
  inviteToken    String?             @unique
  inviteExpires  DateTime? // invite and password reset links stop working after this
  resetSentAt    DateTime? // last "forgot password" email, to stop floods
  sessionVersion Int                 @default(0) // bumped to sign someone out everywhere
  role           Role                @default(MEMBER)
  locationId     String
  location       Location            @relation(fields: [locationId], references: [id])
  teamId         String?
  team           Team?               @relation(fields: [teamId], references: [id])
  weeklyTarget   Float               @default(40) // "Expected hours per week" on screen
  employeeId     String?             @unique // the company's own ID for the person; also kept unique ignoring case by the app
  joiningDate    DateTime?           @db.Date // when they joined the company, shown as years of experience
  photoAt        DateTime? // when their profile picture last changed; null when they have none
  photo          ProfilePhoto?
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  entries        TimeEntry[]
  timesheets     Timesheet[]
  timesheetRows  TimesheetRow[]
  managing       ProjectManager[]
  access         ProjectUserAccess[]
  audit          AuditLog[]
  timer          TimerRun?
  timeOff        TimeOff[]           @relation("TimeOffPerson")
  timeOffAdded   TimeOff[]           @relation("TimeOffAddedBy")
}

/// A person's profile picture: a 256x256 JPEG made in the browser. Kept apart from User so lists of people don't load it.
model ProfilePhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  updatedAt DateTime @updatedAt
}

model Client {
  id           String          @id @default(cuid())
  name         String          @unique
  color        String          @default("s1")
  type         ClientType      @default(FLOATING)
  monthlyHours Float? // contracted hours per month, for FIXED clients only
  projects     Project[]
  teamId       String? // the team that looks after this client
  team         Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  contacts     ClientContact[]
  shareToken        String?   @unique // the secret in the client's view-only report link; null while the link is off
  shareApprovedOnly Boolean   @default(false) // the shared report counts only time in approved timesheets
  shareViewedAt     DateTime? // when the link was last opened (updated at most once an hour)
}

// People at the client who are the points of contact.
model ClientContact {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String
  email    String @default("")
  phone    String @default("")
  sort     Int    @default(0)

  @@index([clientId])
}

// A running timer: one per person. Stopping it adds the time entries.
model TimerRun {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  phaseId     String?
  tagIds      String[] @default([])
  description String   @default("")
  startedAt   DateTime @default(now())
}

model Project {
  id          String                  @id @default(cuid())
  name        String
  clientId    String
  client      Client                  @relation(fields: [clientId], references: [id])
  budgetHours Float?
  access      Access                  @default(PUBLIC)
  archived    Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  phases      Phase[]
  managers    ProjectManager[]
  locations   ProjectLocationAccess[]
  teams       ProjectTeamAccess[]
  users       ProjectUserAccess[]
  entries     TimeEntry[]
  sheetRows   TimesheetRow[]

  @@unique([clientId, name])
}

model Phase {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  sort      Int         @default(0)
  entries   TimeEntry[]
}

model ProjectManager {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model ProjectLocationAccess {
  projectId  String
  locationId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([projectId, locationId])
}

model ProjectTeamAccess {
  projectId String
  teamId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([projectId, teamId])
}

model ProjectUserAccess {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model PhaseTemplate {
  id     String   @id @default(cuid())
  name   String   @unique
  phases String[]
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
}

model CustomField {
  id       String   @id @default(cuid())
  name     String   @unique
  type     String   @default("text") // "text" | "select"
  options  String[]
  required Boolean  @default(false)
  sort     Int      @default(0)
}

model TimeEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  phaseId     String?
  phase       Phase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  tagIds      String[] @default([]) // the entry's tags (ids of Tag), always sorted by id so the same set of tags is the same list; removeTag takes a removed tag out of it
  date        DateTime @db.Date
  startMin    Int      @default(540)
  minutes     Int
  description String   @default("")
  custom      Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([userId, date])
  @@index([projectId, date])
  @@index([date])
  @@index([tagIds], type: Gin)
}

model Timesheet {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime    @db.Date
  status    SheetStatus @default(DRAFT)
  comment   String      @default("")
  updatedAt DateTime    @updatedAt

  @@unique([userId, weekStart])
}

/// A project someone added as a row on their timesheet for one week, so it shows before any time is logged on it.
model TimesheetRow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, weekStart, projectId])
}

/// A public holiday in one office. It takes that day out of everyone's expected hours in that office
/// (half of it when fraction is 0.5). Time can still be logged on it; that counts as extra.
model Holiday {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  name       String
  fraction   Float    @default(1) // 1 = the whole day, 0.5 = half a day
  createdAt  DateTime @default(now())

  @@unique([locationId, date])
  @@index([date])
}

/// A stretch of time off (PTO, sick leave...) for one person, from startDate to endDate. It takes its Monday to Friday
/// days out of that person's expected hours (fraction 0.5 = half of each day). Time can still be logged on it.
/// Leave pulled from an HR system later (Keka) lands here too: source says where a row came from ("manual" is typed in
/// the app), externalId is the other system's id for it, and rows from another system can't be edited in the app.
model TimeOff {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("TimeOffPerson", fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  fraction    Float    @default(1)
  label       String   @default("PTO")
  note        String   @default("")
  source      String   @default("manual")
  externalId  String?
  createdById String? // who added it; null for rows that came from another system
  createdBy   User?    @relation("TimeOffAddedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, externalId])
  @@index([userId, startDate, endDate])
}

model Settings {
  id                 Int       @id @default(1)
  timeFormat         String    @default("decimal") // "decimal" | "hhmm"
  requireTag         Boolean   @default(true)
  requireDescription Boolean   @default(true)
  lockBefore         DateTime? @db.Date
  dailyMinimum       Float     @default(6)
  remindSubmit       Boolean   @default(true)
  remindSubmitDay    Int       @default(5) // 1 = Monday
  remindSubmitTime   String    @default("16:00")
  remindDaily        Boolean   @default(true)
  remindApprovers    Boolean   @default(true)
  timeZone           String    @default("UTC") // the company's time zone, used for "today" and "this week"
}

model AuditLog {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String
  targetUserId String? // the person the action was about, so managers only see changes to their own people

  @@index([at])
  @@index([targetUserId])
}

// Recent failed sign-ins, keyed by email and by IP address, to slow down password guessing.
model AuthAttempt {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now())

  @@index([key, at])
}

// Values the app generates for itself on first use (e.g. the key that signs login cookies), so a new install needs no secrets in its settings.
model AppSecret {
  key   String @id
  value String
}
