generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  LEADER
  PM
  LOCATION
  ADMIN
}

enum Access {
  PUBLIC
  RESTRICTED
}

/// FIXED: the client agreed to a set number of hours each month. FLOATING: no commitment, work as it comes.
enum ClientType {
  FIXED
  FLOATING
}

enum SheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model Location {
  id        String                  @id @default(cuid())
  name      String                  @unique
  managerId String?
  teams     Team[]
  users     User[]
  access    ProjectLocationAccess[]
}

model Team {
  id         String              @id @default(cuid())
  name       String
  locationId String
  location   Location            @relation(fields: [locationId], references: [id])
  users      User[]
  access     ProjectTeamAccess[]

  @@unique([name, locationId])
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String
  title          String              @default("")
  passwordHash   String?
  inviteToken    String?             @unique
  inviteExpires  DateTime? // invite and password reset links stop working after this
  resetSentAt    DateTime? // last "forgot password" email, to stop floods
  sessionVersion Int                 @default(0) // bumped to sign someone out everywhere
  role           Role                @default(MEMBER)
  locationId     String
  location       Location            @relation(fields: [locationId], references: [id])
  teamId         String?
  team           Team?               @relation(fields: [teamId], references: [id])
  weeklyTarget   Float               @default(40) // "Expected hours per week" on screen
  employeeId     String?             @unique // the company's own ID for the person; also kept unique ignoring case by the app
  joiningDate    DateTime?           @db.Date // when they joined the company, shown as years of experience
  photoAt        DateTime? // when their profile picture last changed; null when they have none
  photo          ProfilePhoto?
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  entries        TimeEntry[]
  timesheets     Timesheet[]
  timesheetRows  TimesheetRow[]
  managing       ProjectManager[]
  access         ProjectUserAccess[]
  audit          AuditLog[]
}

/// A person's profile picture: a 256x256 JPEG made in the browser. Kept apart from User so lists of people don't load it.
model ProfilePhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  updatedAt DateTime @updatedAt
}

model Client {
  id           String     @id @default(cuid())
  name         String     @unique
  color        String     @default("s1")
  type         ClientType @default(FLOATING)
  monthlyHours Float? // contracted hours per month, for FIXED clients only
  projects     Project[]
}

model Project {
  id          String                  @id @default(cuid())
  name        String
  clientId    String
  client      Client                  @relation(fields: [clientId], references: [id])
  budgetHours Float?
  access      Access                  @default(PUBLIC)
  archived    Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  phases      Phase[]
  managers    ProjectManager[]
  locations   ProjectLocationAccess[]
  teams       ProjectTeamAccess[]
  users       ProjectUserAccess[]
  entries     TimeEntry[]
  sheetRows   TimesheetRow[]

  @@unique([clientId, name])
}

model Phase {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  sort      Int         @default(0)
  entries   TimeEntry[]
}

model ProjectManager {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model ProjectLocationAccess {
  projectId  String
  locationId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([projectId, locationId])
}

model ProjectTeamAccess {
  projectId String
  teamId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([projectId, teamId])
}

model ProjectUserAccess {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model PhaseTemplate {
  id     String   @id @default(cuid())
  name   String   @unique
  phases String[]
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  entries TimeEntry[]
}

model CustomField {
  id       String   @id @default(cuid())
  name     String   @unique
  type     String   @default("text") // "text" | "select"
  options  String[]
  required Boolean  @default(false)
  sort     Int      @default(0)
}

model TimeEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  phaseId     String?
  phase       Phase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  tagId       String?
  tag         Tag?     @relation(fields: [tagId], references: [id], onDelete: SetNull)
  date        DateTime @db.Date
  startMin    Int      @default(540)
  minutes     Int
  description String   @default("")
  custom      Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([userId, date])
  @@index([projectId, date])
  @@index([date])
}

model Timesheet {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime    @db.Date
  status    SheetStatus @default(DRAFT)
  comment   String      @default("")
  updatedAt DateTime    @updatedAt

  @@unique([userId, weekStart])
}

/// A project someone added as a row on their timesheet for one week, so it shows before any time is logged on it.
model TimesheetRow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, weekStart, projectId])
}

model Settings {
  id                 Int       @id @default(1)
  timeFormat         String    @default("decimal") // "decimal" | "hhmm"
  requireTag         Boolean   @default(true)
  requireDescription Boolean   @default(true)
  lockBefore         DateTime? @db.Date
  dailyMinimum       Float     @default(6)
  remindSubmit       Boolean   @default(true)
  remindSubmitDay    Int       @default(5) // 1 = Monday
  remindSubmitTime   String    @default("16:00")
  remindDaily        Boolean   @default(true)
  remindApprovers    Boolean   @default(true)
  timeZone           String    @default("UTC") // the company's time zone, used for "today" and "this week"
}

model AuditLog {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String
  targetUserId String? // the person the action was about, so managers only see changes to their own people

  @@index([at])
  @@index([targetUserId])
}

// Recent failed sign-ins, keyed by email and by IP address, to slow down password guessing.
model AuthAttempt {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now())

  @@index([key, at])
}

// Values the app generates for itself on first use (e.g. the key that signs login cookies), so a new install needs no secrets in its settings.
model AppSecret {
  key   String @id
  value String
}
